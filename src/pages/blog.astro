---
import RootLayout from '@/layouts/root.layout.astro';
import BlogPost from '@/components/blog-post.astro';
import type { Post } from '@/types/post';


const allPosts = Object.values(import.meta.glob('./posts/*.md', { eager: true })) as Post[];
---
<RootLayout pageTitle="My Astro Learning Blog">
  <h1>My Astro Learning Blog</h1>
  <p>This is where I will post about my journey learning Astro.</p>
  <ul>
    {allPosts.map((post) => (
      <BlogPost title={post.frontmatter.title} url={post.url} />
    ))}
  </ul>
</RootLayout>